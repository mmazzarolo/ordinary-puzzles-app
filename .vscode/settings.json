  "editor.formatOnSave": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "oxc.enable": true,
  "oxc.fmt.experimental": true,
  "typescript.preferences.importModuleSpecifier": "auto",
  "typescript.tsdk": "node_modules/typescript/lib",

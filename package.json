{
  "name": "ordinary-puzzles",
  "version": "1.4.0",
  "private": true,
  "author": "Mazzarolo Matteo",
  "description": "Minimalistic puzzle game inspired by Picross and Sudoku.",
  "main": "index.js",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --clear --platform web --output-dir dist-web && node scripts/patch-web-export.mjs",
    "export:web:play": "WEB_PUBLIC_PATH=/play pnpm run export:web",
    "export:web:electron": "WEB_PUBLIC_PATH=. pnpm run export:web",
    "electron:dev": "concurrently -k -s first \"pnpm run electron:dev:web\" \"pnpm run electron:dev:app\"",
    "electron:dev:web": "EXPO_PUBLIC_ELECTRON=1 expo start --web --port 8081",
    "electron:dev:app": "wait-on http://127.0.0.1:8081 && electron public/electron.js http://127.0.0.1:8081",
    "electron:build": "pnpm run export:web:electron && pnpm run electron:package",
    "electron:package": "electron-builder build --mac -c.extraMetadata.main=public/electron.js --publish never",
    "test:electron": "pnpm run export:web:electron && node scripts/electron-smoke.mjs",
    "test": "jest --runInBand --no-watchman",
    "test:native:android": "node scripts/native-smoke-android.mjs",
    "test:watch": "jest --watch --no-watchman",
    "e2e": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test",
    "e2e:install-browsers": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright install chromium firefox webkit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/dom-webview": "~56.0.6",
    "@expo/metro-runtime": "~56.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~56.0.15",
    "expo-asset": "~56.0.19",
    "expo-audio": "~56.0.12",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-keep-awake": "~56.0.3",
    "expo-navigation-bar": "~56.0.3",
    "expo-splash-screen": "~56.0.12",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "lodash": "^4.18.1",
    "mobx": "^6.16.1",
    "mobx-react-lite": "^4.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-web": "~0.21.0",
    "tinycolor2": "^1.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@playwright/test": "^1.61.0",
    "@react-native/jest-preset": "0.85.3",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.20",
    "@types/react": "~19.2.2",
    "@types/tinycolor2": "^1.4.6",
    "@typescript-eslint/parser": "^8.61.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "56.0.17",
    "concurrently": "10.0.3",
    "electron": "43.1.0",
    "electron-builder": "26.15.3",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~56.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "prettier": "^3.8.4",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "wait-on": "9.0.10"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.mmazzarolo.ordinarypuzzles",
    "files": [
      "public/electron.js",
      "dist-web/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "npmRebuild": false,
    "directories": {
      "buildResources": "public"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.puzzle-games"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "deb",
      "category": "Games"
    }
  }
}

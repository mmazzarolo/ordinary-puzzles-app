{
  "name": "ordinary-puzzles",
  "version": "1.4.0",
  "private": true,
  "description": "Minimalistic puzzle game inspired by Picross and Sudoku.",
  "author": "Mazzarolo Matteo",
  "main": "index.js",
  "scripts": {
    "prepare:fonts": "node scripts/prepare-fonts.mjs",
    "start": "pnpm run prepare:fonts && expo start",
    "android": "pnpm run prepare:fonts && expo start --android",
    "ios": "pnpm run prepare:fonts && expo start --ios",
    "web": "pnpm run prepare:fonts && expo start --web",
    "export:web": "pnpm run prepare:fonts && EXPO_PUBLIC_E2E_AUTO_SOLVE=0 expo export --clear --platform web --output-dir dist-web && node scripts/patch-web-export.mjs",
    "export:web:e2e": "pnpm run prepare:fonts && expo export --clear --platform web --output-dir dist-web-e2e && WEB_OUTPUT_DIR=dist-web-e2e node scripts/patch-web-export.mjs",
    "export:web:play": "WEB_PUBLIC_PATH=/play pnpm run export:web",
    "export:web:electron": "WEB_PUBLIC_PATH=. pnpm run export:web",
    "electron:dev": "pnpm run prepare:fonts && concurrently -k -s first \"pnpm run electron:dev:web\" \"pnpm run electron:dev:app\"",
    "electron:dev:web": "EXPO_PUBLIC_ELECTRON=1 expo start --web --port 8081",
    "electron:dev:app": "wait-on http://127.0.0.1:8081 && electron public/electron.js http://127.0.0.1:8081",
    "electron:build": "pnpm run export:web:electron && electron-builder build --mac -c.extraMetadata.main=public/electron.js --publish never",
    "electron:package": "pnpm run electron:build",
    "test:electron": "pnpm run export:web:electron && node scripts/electron-smoke.mjs",
    "test": "jest --runInBand --no-watchman",
    "bench:generator": "node scripts/benchmark-generator.mjs",
    "bench:native-generator": "node scripts/benchmark-native-generator.mjs",
    "generate:puzzle-pack-sample": "node scripts/generate-puzzle-pack-sample.mjs",
    "measure:generator-matrix": "node scripts/measure-generator-matrix.mjs",
    "e2e:native": "maestro test --exclude-tags android .maestro",
    "e2e:native:smoke": "maestro test --include-tags smoke --exclude-tags android .maestro",
    "e2e:native:android": "maestro test -p android .maestro",
    "e2e:native:ios": "maestro test -p ios --exclude-tags android .maestro",
    "e2e:native:build:ios": "EXPO_PUBLIC_E2E_AUTO_SOLVE=1 pnpm run prepare:fonts && EXPO_PUBLIC_E2E_AUTO_SOLVE=1 expo run:ios --no-install --configuration Release",
    "e2e:native:build:android": "EXPO_PUBLIC_E2E_AUTO_SOLVE=1 pnpm run prepare:fonts && EXPO_PUBLIC_E2E_AUTO_SOLVE=1 expo run:android --no-install --variant release",
    "eas:build:android": "pnpm run prepare:fonts && eas build --platform android --profile production",
    "eas:build:ios": "pnpm run prepare:fonts && eas build --platform ios --profile production",
    "test:watch": "jest --watch --no-watchman",
    "e2e": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test",
    "e2e:install-browsers": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright install chromium firefox webkit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "~57.0.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.9",
    "expo-asset": "~57.0.8",
    "expo-audio": "~57.0.3",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-keep-awake": "~57.0.1",
    "expo-navigation-bar": "~57.0.2",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "lodash": "^4.18.1",
    "mobx": "^6.16.1",
    "mobx-react-lite": "^4.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0",
    "tinycolor2": "^1.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@playwright/test": "^1.61.0",
    "@react-native/jest-preset": "0.86.2",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.20",
    "@types/react": "~19.2.2",
    "@types/tinycolor2": "^1.4.6",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "57.0.5",
    "concurrently": "10.0.3",
    "electron": "43.1.0",
    "electron-builder": "26.15.3",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.3",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "wait-on": "9.0.10"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "packageManager": "pnpm@11.8.0",
  "build": {
    "appId": "com.mmazzarolo.ordinarypuzzles",
    "files": [
      "public/electron.js",
      "dist-web/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "npmRebuild": false,
    "directories": {
      "buildResources": "public"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.puzzle-games"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "deb",
      "category": "Games"
    }
  }
}
